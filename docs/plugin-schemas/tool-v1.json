{
  "$ref": "#/definitions/tool",
  "definitions": {
    "tool": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "inputSchema": {
          "type": "object",
          "additionalProperties": {}
        },
        "outputSchema": {
          "type": "object",
          "additionalProperties": {}
        },
        "executor": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "host-alias"
                },
                "target": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              },
              "required": [
                "type",
                "target"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "mcp"
                },
                "url": {
                  "type": "string",
                  "format": "uri",
                  "maxLength": 512
                },
                "remoteName": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "secretSlot": {
                  "type": "string",
                  "maxLength": 48,
                  "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
                }
              },
              "required": [
                "type",
                "url",
                "remoteName"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "description",
        "inputSchema",
        "executor"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
