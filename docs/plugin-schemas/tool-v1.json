{
  "$ref": "#/definitions/tool",
  "definitions": {
    "tool": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "inputSchema": {
          "type": "object",
          "additionalProperties": {}
        },
        "outputSchema": {
          "type": "object",
          "additionalProperties": {}
        },
        "approval": {
          "type": "string",
          "enum": ["install", "session", "call"],
          "description": "三级人审门；缺省 session（首次调用批准后本会话放行）"
        },
        "executor": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "host-alias"
                },
                "target": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              },
              "required": [
                "type",
                "target"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "mcp"
                },
                "url": {
                  "type": "string",
                  "format": "uri",
                  "maxLength": 512
                },
                "remoteName": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "secretSlot": {
                  "type": "string",
                  "maxLength": 48,
                  "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
                }
              },
              "required": [
                "type",
                "url",
                "remoteName"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "host-workflow"
                },
                "steps": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 8,
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 64,
                        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                      },
                      "tool": {
                        "type": "string",
                        "pattern": "^builtin/[a-z][a-z0-9_]*$"
                      },
                      "args": {
                        "type": "object",
                        "additionalProperties": {}
                      },
                      "optional": {
                        "type": "boolean",
                        "default": false,
                        "description": "普通工具失败时继续执行；安全拒绝/超时仍中止"
                      }
                    },
                    "required": ["id", "tool"],
                    "additionalProperties": false
                  }
                },
                "output": {
                  "type": "object",
                  "properties": {
                    "from": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64,
                      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                    },
                    "path": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    }
                  },
                  "required": ["from"],
                  "additionalProperties": false
                }
              },
              "required": ["type", "steps"],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "description",
        "inputSchema",
        "executor"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
