# Chrome Extension Private Key
# Copy this file to .env and replace with your actual private key
# This key is used for Chrome extension packaging and should be kept secure
CHROME_EXTENSION_KEY=YOUR_PRIVATE_KEY_HERE

# Browser UUID - Unique identifier for this browser instance
# This value is injected at build time and sent as a query parameter when connecting to the WebSocket server
# Generate a UUID v4: https://www.uuidgenerator.net/
BROWSER_UUID=
